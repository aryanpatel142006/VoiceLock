.swarm-run/
.env
node_modules/
.venv/
.venv
__pycache__/
*.pyc
artifacts/**/*.png
artifacts/**/*.mp4

# planner scratch (swarm plan writes it every run)
.swarm/tasks.proposed.json

# audio/video artifacts and model weights stay out of git (fixtures are generated by eval/make_fixtures.py)
*.wav
*.flac
*.mp4
*.mov
*.webm
!eval/fixtures/tiny/*.wav
eval/fixtures/generated/
eval/fixtures/real/
eval/results/*.json
models/
.cache/

# build metadata
*.egg-info/
# benchmark outputs live in the main checkout only
eval/results/*
!eval/results/.gitkeep

# Local replay build metadata
eval/fixtures/demo/manifest.json

# benchmark/bake-off results belong in $HEARING_RESULTS_DIR
results/*
!results/metrics/

# demo clips are generated (make_fixtures --demo): media and stems stay out of git, manifests are committed
eval/fixtures/demo/*/clip.mp4
eval/fixtures/demo/*/stems/
REVISION

# Overnight rendered audio/feature shards (teammates voices): never committed
eval/shards/**/*.wav
eval/shards/**/*.flac
eval/shards/**/*.mp3
eval/shards/**/*.npy
eval/shards/**/*.npz
eval/shards/**/*.pt

# Voice embeddings / feature arrays of the teammates: never committed
eval/data/*.npz
eval/data/*.npy

# T-306 augmented team audio: wavs live in the main checkout only; manifest.json + spot_check.json are committed
eval/augmented/**/*.wav

# Playwright MCP session logs written by worker browser checks
.playwright-mcp/

# macOS Finder metadata
.DS_Store

# web demo build output and the recorded clips it ships (deploy/README.md)
deploy/site/
deploy/media/
.vercel/
